{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/vite-index.html"
    }
  ],
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy.html",
      "permanent": true
    }
  ]
}

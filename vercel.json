{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/vite-index.html"
    }
  ],
  "redirects": [
    {
      "source": "/assets/images/:name((?!(?:logo_preview_dark|deck|smartdoorlock)\\.png)[^/.]+)\\.png",
      "destination": "/assets/images/:name.webp",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy.html",
      "statusCode": 301
    }
  ]
}

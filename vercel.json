{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "ignoreCommand": "bash vercel_ignore_build.sh",
  "git": {
    "deploymentEnabled": {
      "blog-queue": false
    }
  },
  "headers": [
    {
      "source": "/(.*\\.(?:js|css|webp|png|jpg|jpeg|gif|svg|ico|avif|woff|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/vite-index.html"
    }
  ],
  "redirects": [
    {
      "source": "/assets/images/:name((?!(?:logo_preview_dark|deck|smartdoorlock)\\.png)[^/.]+)\\.png",
      "destination": "/assets/images/:name.webp",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy.html",
      "statusCode": 301
    }
  ]
}
